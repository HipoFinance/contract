digraph {
    label="borrowers request loans"
    node [ colorscheme=pastel19 style=filled ]

    /* Entities */
    borrower1, borrower2, borrower3 [ color=7 ]
    treasury [ color=4 ]

    /* Relationships */
    borrower1 -> treasury [ label="1\l op::request_loan\l 100002 GRAM\l loan: 200000\l min payment: 100\l max stake: 0 (no cap)\l" ]
    borrower2 -> treasury [ label="1\l op::request_loan\l 202 GRAM\l loan: 300000\l min payment: 100\l max stake: 310000\l" ]
    borrower3 -> treasury [ label="1\l op::request_loan\l 302 GRAM\l loan: 300000\l min payment: 200\l max stake: 0 (no cap)\l" ]

    /* Ranks */
    { rank=min borrower1 borrower2 borrower3 }
    { rank=max treasury }
}
