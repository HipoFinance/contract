digraph {
    label="anyone sends a message to finish participation"
    node [ colorscheme=pastel19 style=filled ]
    edge [ colorscheme=set39 ]

    /* Entities */
    external [ shape=point ]
    treasury [ color=4 ]
    loan1, loan2 [ color=8 ]
    elector [ color=1 ]
    borrower1, borrower2 [ color=7 ]
    governor [ color=2 ]
    burner [ color=3 ]

    /* Relationships */
    external -> treasury [ label="1\l op::finish_participation\l" ]
    treasury -> treasury [ label="2\l op::recover_stakes\l" ]

    treasury -> loan1 [ label="3\l op::proxy_recover_stake\l 1 GRAM\l" color=1 ]
    loan1 -> elector [ label="4\l op::recover_stake\l 1 GRAM\l" color=1 ]
    elector -> loan1 [ label="5\l op::recover_stake_ok\l 300101 GRAM\l" color=1 ]
    loan1 -> treasury [ label="6\l op::recover_stake_result\l 300101 GRAM\l" color=1 ]
    treasury -> burner [ label="7\l op::take_borrower_fee\l 20 GRAM\l" color=1 ]
    treasury -> borrower1 [ label="8\l op::loan_result\l 100030 GRAM\l" color=1 ]
    treasury -> governor [ label="9\l op::take_profit\l 50 GRAM\l" color=1 ]

    treasury -> loan2 [ label="10\l op::proxy_recover_stake\l 1 GRAM\l" color=4 ]
    loan2 -> elector [ label="11\l op::recover_stake\l 1 GRAM\l" color=4 ]
    elector -> loan2 [ label="12\l op::recover_stake_ok\l 300101 GRAM\l" color=4 ]
    loan2 -> treasury [ label="13\l op::recover_stake_result\l 300101 GRAM\l" color=4 ]
    treasury -> burner [ label="14\l op::take_borrower_fee\l 20 GRAM\l" color=4 ]
    treasury -> borrower2 [ label="15\l op::loan_result\l 230 GRAM\l" color=4 ]
    treasury -> governor [ label="16\l op::take_profit\l 50 GRAM\l" color=4 ]

    /* take_borrower_fee is sent only while borrower_fee is non-zero, and always before take_profit:
       take_profit sweeps the unreserved balance, so anything left implicit would go to the governor
       instead of the burner. */

    /* Ranks */
    { rank=min borrower1 borrower2 governor burner }
    { rank=same external treasury }
    { rank=max elector }
}
