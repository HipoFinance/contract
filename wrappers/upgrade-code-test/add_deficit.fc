#include "../../contracts/imports/stdlib.fc";

;; One-off migrator for the deficit counter: inserts a `deficit` coins field into treasury root
;; storage between total_borrowers_stake and parent, starting at zero.
;;
;; This is never deployed. It rides inside the upgrade message as `migrate_code`, and the treasury
;; blesses the cell and enters it at 0x6d67 for the duration of one transaction. See
;; `run_migrator` in contracts/treasury.fc and the procedure in scripts/upgrade_treasury.md.
;;
;; Three rules, all enforced by tests/TreasuryMigration.spec.ts:
;;   - no COMMIT, or a failed migration becomes permanent instead of reverting
;;   - no SETCODE, or this could redirect the treasury behind the upgrade message's back
;;   - everything inlined, so the compiled cell holds exactly method ids 0 and 0x6d67. EXECUTE leaves
;;     c3 pointing at the treasury, so a non-inlined function here would CALLDICT into the
;;     treasury's own dictionary.
;;
;; It parses the old layout by hand rather than through a load_data() helper. By the time this runs,
;; upgrade_code has already called set_c3, so the treasury's own load_data() is the NEW parser and
;; would read the leading bits of parent's address as a coins value, desyncing everything after it.
;;
;; The trailing end_parse() is the re-run guard. Against a cell that already carries a deficit there
;; are bits left over, so it throws and the whole upgrade reverts.
() migrate() impure method_id(0x6d67) {
    slice old = get_data().begin_parse();
    int old_total_coins = old~load_coins();
    int old_total_tokens = old~load_coins();
    int old_total_staking = old~load_coins();
    int old_total_unstaking = old~load_coins();
    int old_total_borrowers_stake = old~load_coins();
    slice old_parent = old~load_msg_addr();
    cell old_participations = old~load_dict();
    int old_rounds_imbalance = old~load_uint(8);
    int old_stopped = old~load_int(1);
    int old_instant_mint = old~load_int(1);
    cell old_loan_codes = old~load_ref();
    cell old_extension = old~load_ref();
    old.end_parse();

    begin_cell()
        .store_coins(old_total_coins)
        .store_coins(old_total_tokens)
        .store_coins(old_total_staking)
        .store_coins(old_total_unstaking)
        .store_coins(old_total_borrowers_stake)
        .store_coins(0) ;; deficit
        .store_slice(old_parent)
        .store_dict(old_participations)
        .store_uint(old_rounds_imbalance, 8)
        .store_int(old_stopped, 1)
        .store_int(old_instant_mint, 1)
        .store_ref(old_loan_codes)
        .store_ref(old_extension)
        .end_cell()
        .set_data();
}

;; A migrator is never deployed and never receives a message. This exists only because a compiled
;; contract needs an entry point, and it is the other half of the two-method-id rule above.
() recv_internal(cell in_msg_full, slice in_msg_body) impure {
    throw(0xffff);
}
